<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_nearby_courts.xml -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1628">

    <!-- TOP BAR -->
    <Button
        android:id="@+id/btnBackCourts"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="←"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEARBY COURTS"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toTopOf="@id/btnBackCourts"
        app:layout_constraintBottom_toBottomOf="@id/btnBackCourts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Search radius chip row -->
    <HorizontalScrollView
        android:id="@+id/scrollRadius"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/btnBackCourts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/chip1km"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="1 km" android:textSize="12sp" android:textColor="#FFFFFF"
                android:backgroundTint="#64FFDA"
                android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/chip5km"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="5 km" android:textSize="12sp" android:textColor="#FFFFFF"
                android:backgroundTint="#112240"
                android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/chip10km"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="10 km" android:textSize="12sp" android:textColor="#FFFFFF"
                android:backgroundTint="#112240"
                android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/chip25km"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="25 km" android:textSize="12sp" android:textColor="#FFFFFF"
                android:backgroundTint="#112240"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- GOOGLE MAP fragment — takes up most of screen -->
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/scrollRadius"
        app:layout_constraintBottom_toTopOf="@id/cardCourtCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Bottom info card showing court count -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCourtCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#112240"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="70dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 Padel courts found nearby"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvCourtCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Searching..."
                android:textColor="#64FFDA"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#CC0A1628"
        app:itemIconTint="@drawable/bottom_nav_color_selector"
        app:itemTextColor="@drawable/bottom_nav_color_selector"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>