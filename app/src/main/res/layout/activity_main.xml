<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_main.xml — UPDATED with BottomNavigationView -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ① BACKGROUND IMAGE -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/padel_background"
        android:scaleType="centerCrop"
        android:contentDescription="Padel court background" />

    <!-- Dark overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- ② LOGO IMAGE -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/padel_logo"
        android:scaleType="fitCenter"
        android:contentDescription="Padel VAR Logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp" />

    <!-- App title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PADEL VAR"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        app:layout_constraintTop_toBottomOf="@id/logoImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI-Powered Video Assistant Referee"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- ③ ANIMATED BALL -->
    <ImageView
        android:id="@+id/animatedBall"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/padel_ball"
        android:scaleType="fitCenter"
        android:contentDescription="Animated padel ball"
        app:layout_constraintTop_toBottomOf="@id/subtitleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <!-- Phone Call Button -->
    <Button
        android:id="@+id/btnCall"
        android:layout_width="220dp"
        android:layout_height="48dp"
        android:text="📞  Contact Referee"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:background="@drawable/btn_outline_bg"
        app:layout_constraintBottom_toTopOf="@id/btnLiveAnalysis"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"/>

    <!-- BUTTON 1 — Live Analysis -->
    <Button
        android:id="@+id/btnLiveAnalysis"
        android:layout_width="220dp"
        android:layout_height="55dp"
        android:text="▶  LIVE ANALYSIS"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/btn_green_bg"
        app:layout_constraintBottom_toTopOf="@id/btnReplay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"/>

    <!-- BUTTON 2 — Replay Review -->
    <Button
        android:id="@+id/btnReplay"
        android:layout_width="220dp"
        android:layout_height="55dp"
        android:text="⏪  REPLAY REVIEW"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/btn_outline_bg"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"/>

    <!-- ════════════════════════════════════════════ -->
    <!-- BOTTOM NAVIGATION BAR — anchored to bottom  -->
    <!-- ════════════════════════════════════════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#CC0A1628"
        app:itemIconTint="@drawable/bottom_nav_color_selector"
        app:itemTextColor="@drawable/bottom_nav_color_selector"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>